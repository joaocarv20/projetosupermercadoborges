# Copie este arquivo para .env e preencha. O .env NUNCA deve ir para o Git.
ORA_USER=usuario_somente_leitura
ORA_PASS=sua_senha
# Formato: servidor:porta/nome_do_servico   (ex.: 192.168.0.10:1521/ORCL)
ORA_DSN=192.168.0.10:1521/ORCL

# Só se o modo thin não funcionar (Oracle antigo): pasta do Oracle Instant Client
ORA_CLIENT_DIR=

# Tempo máximo de cada consulta, em segundos
ORA_TIMEOUT_SEG=60
